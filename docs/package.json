{
  "name": "treeship-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync:changelog": "node scripts/sync-changelog.mjs",
    "sync:agents-matrix": "node scripts/sync-agents-matrix.mjs",
    "sync:feature-matrix": "node scripts/sync-feature-matrix.mjs",
    "sync:all": "node scripts/sync-changelog.mjs && node scripts/sync-agents-matrix.mjs && node scripts/sync-feature-matrix.mjs",
    "predev": "npm run sync:all",
    "prebuild": "npm run sync:all",
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check:links": "python3 scripts/check-internal-links.py content",
    "check:cli": "python3 scripts/check-cli-commands.py ${TREESHIP_BIN:-treeship} content",
    "check:all": "npm run check:links && npm run check:external && npm run check:api && npm run check:cli && npm run check:flags && npm run check:tables",
    "check:flags": "python3 scripts/check-cli-flags.py ${TREESHIP_BIN:-treeship} content",
    "check:external": "python3 scripts/check-external-links.py content",
    "check:api": "python3 scripts/check-api-routes.py content ../packages/hub/main.go",
    "check:tables": "python3 scripts/check-cli-option-tables.py ${TREESHIP_BIN:-treeship} content"
  },
  "dependencies": {
    "fumadocs-core": "^15.8.5",
    "fumadocs-mdx": "^12.0.2",
    "fumadocs-ui": "^15.8.5",
    "fumadocs-openapi": "^5.0.0",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20",
    "yaml": "^2.9.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.0.0",
    "typescript": "^5"
  }
}
